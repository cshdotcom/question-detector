DATABASE_URL=file:/home/z/my-project/db/custom.db

# 访问密码
# - 默认密码 123456（代码内置兜底，无需配置即可用）
# - 在 .env 设置 APP_PASSWORD 可自定义初始密码
# - 登录后在页面右上角「修改密码」中更改，新密码存数据库并覆盖此处
# - 设置为 disabled 可完全关闭密码保护（公开访问）
APP_PASSWORD=

# 后端默认 AI 配置（所有浏览器共享）
# 填写后所有设备无需单独配置即可使用此 API；前端「AI 设置」里配置的自定义 API 优先
# 支持 OpenAI 兼容端点：OpenAI / DeepSeek / 智谱 GLM / 月之暗面 Kimi / 阿里通义千问 等
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
