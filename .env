DATABASE_URL=file:/home/z/my-project/db/custom.db

# 访问密码（不填或留空 = 公开访问，不要求登录）
# 设置后访问网站需要先在 /login 页面输入此密码
APP_PASSWORD=

# 后端默认 AI 配置（部署时统一配置，所有浏览器共享）
# 填写后所有浏览器无需单独配置即可使用此 API；前端 localStorage 配置可覆盖
# 支持 OpenAI 兼容端点：OpenAI / DeepSeek / 智谱 GLM / 月之暗面 Kimi / 阿里通义千问 等
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
